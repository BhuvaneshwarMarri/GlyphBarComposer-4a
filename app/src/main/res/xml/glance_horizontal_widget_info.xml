<?xml version="1.0" encoding="utf-8"?>
<!--
    res/xml/glance_horizontal_widget_info.xml
    V1 – Horizontal glyph button row
    Minimum size: 250 × 110 dp  (≈ 4 × 2 launcher cells)
    Resize:       horizontal only
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_horizontal_description"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="450dp"
    android:maxResizeHeight="130dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
